# Safe local-development placeholders only. Do not place real secrets in this file.
APP_ENV=local
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campusone
POSTGRES_USERNAME=campusone
POSTGRES_PASSWORD=change-me

JWT_SECRET=replace-with-a-local-development-secret
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=604800

# Optional/future: configure only if an approved Redis use case is introduced.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
