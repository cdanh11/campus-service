# Safe local-development placeholders only. Do not place real secrets in this file.
APP_ENV=local
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campus_service
POSTGRES_USERNAME=campus_service
POSTGRES_PASSWORD=change-me

JWT_ISSUER=campus-service
JWT_AUDIENCE=campus-service-clients
JWT_SECRET=replace-with-a-base64-encoded-256-bit-local-secret
JWT_ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P30D
REFRESH_COOKIE_NAME=CAMPUS_REFRESH
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_PATH=/api/v1/auth
ALLOWED_ORIGINS=http://localhost:3000

# Optional/future: configure only if an approved Redis use case is introduced.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
